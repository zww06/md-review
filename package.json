{
  "name": "md-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "md-review": "dist-server/server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "start": "node dist-server/server/index.js",
    "dev": "npm run build && npm start --",
    "link-cli": "npm run build && npm link"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
